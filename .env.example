# Browser-safe Supabase project configuration. Use a Publishable key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-project-key

# Optional override: root-relative path to another authorized same-site audio file in public/.
# VITE_SIGNATURE_AUDIO_SRC=/audio/another-authorized-clip.mp3
